{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SPHSS School Management",
  "version": "1.0.0",
  "identifier": "com.smartpea.sphss",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smart Pea Higher Secondary School",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "splash",
        "title": "SmartPea",
        "width": 400,
        "height": 250,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "url": "/splash"
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/smart_pea.db"
    ]
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyNTZCNUVCQ0Q4MzIwMTYKUldRV0lJUE42N1ZXOHRFejBtcVMwR1FLVm01emdySHB3ZXVZUDlXbWRXTnRJTENNT1NzMndBbUQK",
      "endpoints": [
        "https://YOUR_UPDATE_SERVER/latest.json"
      ]
    }
  }
}
